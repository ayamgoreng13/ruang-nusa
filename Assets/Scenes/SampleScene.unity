--- !u!114 &917622719
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 917622713}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b9c93fa102156864a8067d3695beedfd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  promptObject: {fileID: 808166744}
  defaultDialogue:
  - dialogueType: 0
    speakerName: Laras
    sentence: Halo, permisi, Pak.
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 1
    choices: []
  - dialogueType: 0
    speakerName: Orang Lokal
    sentence: Halo! Kamu baru turun dari bus ya, Dek?
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 0
    choices: []
  - dialogueType: 0
    speakerName: Laras
    sentence: Iya Pak.
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 1
    choices: []
  - dialogueType: 0
    speakerName: Orang Lokal
    sentence: Oh ya, orang sini biasa panggil saya Arman. Salam kenal.
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 0
    choices: []
  - dialogueType: 0
    speakerName: Kakek Arman
    sentence: Kalo kamu?
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 0
    choices: []
  - dialogueType: 0
    speakerName: Laras
    sentence: Saya Laras.
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 1
    choices: []
  - dialogueType: 0
    speakerName: Kakek Arman
    sentence: "Jadi, Dek Laras lagi jalan \u2013 jalan?"
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 0
    choices: []
  - dialogueType: 1
    speakerName: 
    sentence: 
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 1
    choices:
    - choiceText: Ingin lihat tempat baru
      mcResponseSentence: "Aku cuman\u2026 Ingin lihat tempat baru."
      npcSpeakerName: Kakek Arman
      npcPortrait: {fileID: 0}
      isNpcOnLeft: 0
      singleResponseSentence: "Ya, kadang memang begitu\u2026 Beberapa orang datang
        kesini bukan buat  liburan."
      isExitChoice: 1
    - choiceText: Mencari sesuatu
      mcResponseSentence: Aku lagi mencari sesuatu.
      npcSpeakerName: Kakek Arman
      npcPortrait: {fileID: 0}
      isNpcOnLeft: 0
      singleResponseSentence: "Ya, kadang memang begitu\u2026 Beberapa orang datang
        kesini bukan buat  liburan."
      isExitChoice: 1
    - choiceText: Datang saja
      mcResponseSentence: "Belum tahu, aku cuman\u2026 Datang aja"
      npcSpeakerName: Kakek Arman
      npcPortrait: {fileID: 0}
      isNpcOnLeft: 0
      singleResponseSentence: "Ya, kadang memang begitu\u2026 Beberapa orang datang
        kesini bukan buat  liburan."
      isExitChoice: 1
  - dialogueType: 0
    speakerName: Kakek Arman
    sentence: "Di sini, orang \u2013 orang hidup pelan. Pagi kerja, sore duduk, terus
      lihat laut."
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 0
    choices: []
  - dialogueType: 0
    speakerName: Kakek Arman
    sentence: Kalau kamu sempat, coba jalan ke pantai sana. Angin nya beda tiap waktu.
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 0
    choices: []
  - dialogueType: 1
    speakerName: 
    sentence: 
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 1
    choices:
    - choiceText: Apa bedanya?
      mcResponseSentence: Memang apa yang beda?
      npcSpeakerName: Kakek Arman
      npcPortrait: {fileID: 0}
      isNpcOnLeft: 0
      singleResponseSentence: "Kadang tenang\u2026 Kadang juga bawa ingatan. Semua
        rasa beda \u2013 beda, Dek. "
      isExitChoice: 0
    - choiceText: Disini orang - orangnya seperti apa?
      mcResponseSentence: "Orang \u2013 orang di sini seperti apa?"
      npcSpeakerName: Kakek Arman
      npcPortrait: {fileID: 0}
      isNpcOnLeft: 0
      singleResponseSentence: Sederhana Saja. Ndak Banyak yang dicari tapi cukup.
      isExitChoice: 0
    - choiceText: Tempat lain untuk dikunjungi
      mcResponseSentence: Ada tempat lain yang harus aku lihat?
      npcSpeakerName: Kakek Arman
      npcPortrait: {fileID: 0}
      isNpcOnLeft: 0
      singleResponseSentence: Kalau mau lihat lebih jauh, naik ke bukit sana. Dari
        atas kelihatan semua.
      isExitChoice: 0
    - choiceText: Lombok itu seperti apa?
      mcResponseSentence: "Lombok itu\u2026 Seperti apa sebenarnya?"
      npcSpeakerName: Kakek Arman
      npcPortrait: {fileID: 0}
      isNpcOnLeft: 0
      singleResponseSentence: Lombok itu sederhana, Dek.
      isExitChoice: 1
  - dialogueType: 0
    speakerName: Kakek Arman
    sentence: "Di sini ada laut\u2026 Bukit, juga ada desa. Orang \u2013 orangnya
      juga begitu, ndak banyak macam."
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 0
    choices: []
  - dialogueType: 0
    speakerName: Kakek Arman
    sentence: "Kalau kamu jalan sedikit, kamu bisa dengar banyak hal\u2026 tanpa
      orang bicara."
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 0
    choices: []
  - dialogueType: 0
    speakerName: Kakek Arman
    sentence: "Kadang orang datang ke sini buat liburan\u2026"
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 0
    choices: []
  - dialogueType: 0
    speakerName: Kakek Arman
    sentence: "Tapi ada juga yang datang\u2026 Buat diam saja."
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 0
    choices: []
  - dialogueType: 0
    speakerName: Laras
    sentence: "Diam saja\u2026?"
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 1
    choices: []
  - dialogueType: 0
    speakerName: Kakek Arman
    sentence: Iya, kadang itu udah cukup.
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 0
    choices: []
  - dialogueType: 0
    speakerName: Kakek Arman
    sentence: "Kalau kamu mau tahu Lombok, jangan buru \u2013 buru, Laras."
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 0
    choices: []
  - dialogueType: 0
    speakerName: Kakek Arman
    sentence: "Jalan saja pelan \u2013 pelan, nanti akan terasa sendiri."
    leftPortrait: {fileID: 4546814638488999432, guid: ee01100e1da95be4e91c62327030d5be, type: 3}
    rightPortrait: {fileID: 3506507866796992836, guid: 7bd8f677a4eb74b438cf50b09f8e447e, type: 3}
    isLeftSpeaker: 0
    choices: []
  questDialogues: []
--- !u!1 &984125809
